# nauth-file: nauth's reconcilers reading resources from a directory.
FROM golang:1.27.0-alpine AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -o nauth-file ./cmd/nauth-file

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /workspace/nauth-file /nauth-file
USER 65532:65532
ENTRYPOINT ["/nauth-file"]
